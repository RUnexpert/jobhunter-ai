# Run node scripts/init-env.mjs to generate local secrets. Never commit .env.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://jobhunter:CHANGE_ME@localhost:5432/jobhunter?schema=public
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
REGISTRATION_CODE=REPLACE_WITH_A_RANDOM_INVITE_CODE
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:3000/api/auth/hh/callback
HH_USER_AGENT=JobHunterAI/1.0 (your-email@example.com)
# Comma-separated exact hostnames. Only trusted administrators may edit.
AI_ALLOWED_HOSTS=api.openai.com,ollama,localhost,127.0.0.1
SMTP_ALLOWED_HOSTS=
NEXT_TELEMETRY_DISABLED=1
# Shared pacing for background hh.ru requests; minimum 500ms, maximum 5000ms.
HH_REQUEST_INTERVAL_MS=500
# Plain HTTP is only allowed for explicitly trusted local AI hosts.
AI_HTTP_ALLOWED_HOSTS=ollama,localhost,127.0.0.1
